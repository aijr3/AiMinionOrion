# ============================================================
# Miro Strategy App — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Strategy App
DATABASE_URL=sqlite:///./uploads/strategy.db
STRATEGY_PORT=8000
ENVIRONMENT=development

# LLM (OpenAI-compatible — also used by MiroFish submodule)
LLM_API_KEY=your_openai_or_compatible_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o

# Zep Cloud memory (used by MiroFish simulation engine)
ZEP_API_KEY=your_zep_cloud_api_key_here

# PostgreSQL (for production — leave blank to use SQLite in dev)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=strategy_db
POSTGRES_USER=strategy
POSTGRES_PASSWORD=strategypass

# Strategy pipeline settings
STRATEGY_MIN_WIN_PROBABILITY_FOR_GRACEFUL_EXIT=0.40
STRATEGY_MAX_COMPETITORS_TO_ANALYZE=10
STRATEGY_MAX_PERSONAS_TO_GENERATE=8
MIROFISH_SIMULATION_ENABLED=false
